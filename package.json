{
  "name": "certificate-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "questions:generate": "node scripts/generate-questions.mjs",
    "questions:audit": "node scripts/clean-question-banks.mjs && node scripts/generate-questions.mjs",
    "questions:import:information-processing": "node scripts/import-information-processing-pdfs.mjs",
    "security:review:validate": "node scripts/validate-security-review-queue.mjs",
    "security:review:prepare": "node scripts/build-security-review-batch.mjs",
    "security:text-quality:audit": "node scripts/audit-security-text-quality.mjs",
    "security:text-quality:recover": "node scripts/apply-security-text-recovery.mjs --apply",
    "security:text-quality:verify": "node --experimental-strip-types scripts/verify-security-text-recovery.mjs",
    "security:text-quality:select": "node scripts/select-security-text-recovery-batch.mjs --limit=50",
    "security:text-quality:evidence": "node scripts/capture-security-text-recovery-evidence.mjs",
    "security:text-quality:apply-batch": "node scripts/apply-security-text-recovery-batch.mjs --apply",
    "security:text-quality:verify-batch": "node --experimental-strip-types scripts/verify-security-text-recovery-batch.mjs",
    "predev": "npm run questions:generate",
    "dev": "next dev",
    "prebuild": "npm run questions:generate",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "katex": "^0.18.4",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "pdfjs-dist": "^6.1.200",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
