    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "pdfjs-dist": "^6.1.200",
    "typescript": "7.0.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
